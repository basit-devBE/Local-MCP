# Copy this to .env and fill in your values
# cp .env.example .env

# ── REQUIRED ──────────────────────────────────────────────────────────────
# A strong random token — LLMs must send this as X-MCP-Token header
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=your-strong-random-token-here

# ── OPTIONAL ──────────────────────────────────────────────────────────────
# Root directory the MCP server is allowed to access
# In Docker this maps to your mounted home directory
FS_ROOT=/host-home

# Server port
PORT=3000

# Set to "production" to enforce auth (required)
NODE_ENV=production

# ngrok auth token (get from https://dashboard.ngrok.com)
# Only needed if using the ngrok service in docker-compose.yml
NGROK_AUTHTOKEN=your-ngrok-authtoken-here
